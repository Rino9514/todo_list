                </mxCell>
                <mxCell id="e5" value="createProject(nom) : Project" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" parent="1" source="app" target="project" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="sauvegarderProjets(Project[])&lt;br&gt;chargerProjets() : Project[] | null" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" parent="1" source="app" target="storage" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="Regle : dom.js n&#39;appelle jamais localStorage directement — seulement les fonctions publiques de app.js.&lt;br&gt;Les identifiants (id) sont des strings generees par crypto.randomUUID(). Les priorites possibles sont « basse » | « moyenne » | « haute »." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacingLeft=8;" parent="1" vertex="1">
