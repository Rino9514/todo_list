                <mxCell id="e4" value="createTodo(titre, description,&lt;br&gt;dateEcheance, priorite) : Todo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" parent="1" source="app" target="todo" edge="1">
